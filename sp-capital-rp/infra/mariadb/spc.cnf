# Configuração base do MariaDB para a SP Capital (ajustar buffer pool à RAM em produção: ~70%)
[mysqld]
default_time_zone = '+00:00'
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
innodb_buffer_pool_size = 1G
innodb_flush_log_at_trx_commit = 1
max_connections = 300
log_bin = mysql-bin
binlog_format = ROW
